{
  "name": "@coder/ai-sdk-effect",
  "version": "0.0.0",
  "description": "Effect bridge for Coder's Vercel AI SDK packages: effect/ai LanguageModel services over Coder AI Gateway and Coder Agents, typed AiError classification, Effect Schema to AI SDK schemas, and scoped Coder workspace Layers.",
  "keywords": [
    "ai",
    "ai-sdk",
    "coder",
    "coder-agents",
    "effect",
    "effect-ai",
    "llm",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/coder/ai-sdk/tree/main/packages/effect#readme",
  "bugs": {
    "url": "https://github.com/coder/ai-sdk/issues"
  },
  "license": "Apache-2.0",
  "author": "Coder Technologies, Inc. (https://coder.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder/ai-sdk.git",
    "directory": "packages/effect"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "attw": "attw --pack --ignore-rules cjs-resolves-to-esm",
    "example:generate": "tsx examples/01-generate.ts",
    "example:structured": "tsx examples/02-structured.ts",
    "example:sandbox": "tsx examples/03-sandbox.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.34",
    "@coder/ai-sdk-agent": "workspace:^",
    "@coder/ai-sdk-provider": "workspace:^",
    "@coder/ai-sdk-sandbox": "workspace:^"
  },
  "devDependencies": {
    "@ai-sdk/harness": "^1.0.167",
    "@ai-sdk/provider-utils": "^5.0.70",
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.156",
    "effect": "4.0.7",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "effect": "~4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
